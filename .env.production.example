# Copy these names to the hosting provider's secret manager. Never commit values.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

PUBLIC_APP_URL=https://app.seu-dominio.com
DATABASE_URL=<postgresql-managed-connection-string>
MEDIA_STORAGE_ROOT=/data/storage

# Generate a random 32-byte key. Rotating it invalidates encrypted OAuth tokens.
OAUTH_TOKEN_KEY=<32-byte-random-key>
ADMIN_EMAIL=<operational-admin-email>
# PowerShell: $env:ADMIN_PASSWORD='uma-senha-longa'; npm.cmd run security:hash-admin
ADMIN_PASSWORD_HASH=<generated-scrypt-hash>

GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_REDIRECT_URI=https://app.seu-dominio.com/workspace/accounts/callback
GOOGLE_AUTH_REDIRECT_URI=https://app.seu-dominio.com/login/callback

TIKTOK_CLIENT_KEY=<tiktok-client-key>
TIKTOK_CLIENT_SECRET=<tiktok-client-secret>
TIKTOK_REDIRECT_URI=https://app.seu-dominio.com/workspace/accounts/callback?provider=tiktok

INSTAGRAM_CLIENT_ID=<meta-app-id>
INSTAGRAM_CLIENT_SECRET=<meta-app-secret>
INSTAGRAM_REDIRECT_URI=https://app.seu-dominio.com/workspace/accounts/callback?provider=instagram

MERCADOPAGO_ACCESS_TOKEN=<APP_USR-production-access-token>
MERCADOPAGO_WEBHOOK_SECRET=<mercado-pago-webhook-secret>
PAYMENT_SUCCESS_URL=https://app.seu-dominio.com/workspace/planos?payment=success
PAYMENT_CANCEL_URL=https://app.seu-dominio.com/workspace/planos?payment=cancel
PAYMENT_WEBHOOK_URL=https://app.seu-dominio.com/api/account/payments/webhook

EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=<resend-api-key>
EMAIL_FROM_ADDRESS="PMP <noreply@seu-dominio.com>"
# MAILGUN_DOMAIN=mg.seu-dominio.com

# Optional but recommended.
SENTRY_DSN=
GOOGLE_SITE_VERIFICATION=
